---
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer class="bg-background border-t border-on-background">
  <div class="flex flex-col md:flex-row justify-between items-center w-full px-8 py-12 gap-8 max-w-[1440px] mx-auto">
    <div class="flex flex-col gap-2 items-center md:items-start">
      <span class="text-lg font-bold text-on-background uppercase font-headline-sm">Euclidity SL</span>
      <span class="font-label-caps text-label-caps text-secondary uppercase">
        © {year} Euclidity SL. TECHNOLOGY CONSULTANCY.
      </span>
    </div>

    <div class="flex gap-2">
      <a href="/about#contact" aria-label="Contact" class="border border-on-background w-8 h-8 flex items-center justify-center hover:bg-primary-container hover:text-on-primary-container transition-none">
        <Icon name="share" size={16} />
      </a>
      <a href="https://github.com/stevejpurves" target="_blank" rel="noreferrer" aria-label="GitHub" class="border border-on-background w-8 h-8 flex items-center justify-center hover:bg-primary-container hover:text-on-primary-container transition-none">
        <Icon name="code" size={16} />
      </a>
    </div>
  </div>
</footer>
