---
const year = new Date().getFullYear();
---

<footer class="bg-surface-container-lowest border-t border-on-background">
  <div class="w-full px-16 py-12 flex flex-col md:flex-row justify-between items-end gap-8 max-w-[1440px] mx-auto">
    <div class="flex flex-col gap-4">
      <span class="text-lg font-bold uppercase tracking-tighter font-h1">Euclidity SL</span>
      <p class="font-label-caps text-[10px] tracking-widest uppercase text-on-surface-variant max-w-xs">
        © {year} Euclidity SL. All rights reserved. Clinical performance guaranteed.<br />
        Tax_ID: B76611763
      </p>
    </div>
    <div class="flex gap-12">
      <div class="flex flex-col gap-2">
        <a class="font-label-caps text-[10px] tracking-widest uppercase text-on-surface-variant hover:text-primary transition-colors" href="/privacy">Privacy</a>
        <a class="font-label-caps text-[10px] tracking-widest uppercase text-on-surface-variant hover:text-primary transition-colors" href="/terms">Terms</a>
      </div>
      <div class="flex flex-col gap-2">
        <a class="font-label-caps text-[10px] tracking-widest uppercase text-on-surface-variant hover:text-primary transition-colors" href="/about#contact">Contact</a>
        <a class="font-label-caps text-[10px] tracking-widest uppercase text-on-surface-variant hover:text-primary transition-colors" href="/projects">Projects</a>
      </div>
    </div>
  </div>
</footer>
