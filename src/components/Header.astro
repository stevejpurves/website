---
interface Props {
  active?: 'services' | 'projects' | 'about' | null;
}

const { active = null } = Astro.props;

const links: { href: string; label: string; key: NonNullable<Props['active']> }[] = [
  { href: '/services', label: 'SERVICES', key: 'services' },
  { href: '/projects', label: 'PROJECTS', key: 'projects' },
  { href: '/about', label: 'ABOUT', key: 'about' },
];
---

<header class="bg-background border-b border-on-background fixed top-0 left-0 right-0 z-50 h-16">
  <nav class="flex justify-between items-center w-full h-full px-8 max-w-[1440px] mx-auto">
    <a href="/" class="text-2xl font-bold tracking-tighter text-on-background uppercase font-headline-md">
      Euclidity SL
    </a>

    <div class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "font-body-md text-sm font-medium uppercase tracking-widest px-2 py-1 transition-none",
            active === link.key
              ? "text-on-background border-b-2 border-primary-container pb-1"
              : "text-secondary hover:bg-primary-container hover:text-on-primary-container",
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <a
      href="/about#contact"
      class="bg-on-background text-background px-6 py-2 font-body-md text-sm font-bold uppercase tracking-widest border border-on-background hover:bg-primary-container hover:text-on-primary-container transition-none"
    >
      GET IN TOUCH
    </a>
  </nav>
</header>
