---
import {
  ArrowRight,
  BadgeCheck,
  CircuitBoard,
  Cloud,
  CloudCheck,
  CloudCog,
  Code,
  Compass,
  Database,
  FlaskConical,
  Gauge,
  Globe,
  Landmark,
  Layers,
  LineChart,
  Mail,
  MapPin,
  Network,
  Send,
  Share2,
  Stethoscope,
  Terminal,
  Waves,
} from '@lucide/astro';

interface Props {
  name:
    | 'developer_board'
    | 'science'
    | 'cloud_sync'
    | 'cloud_done'
    | 'cloud'
    | 'query_stats'
    | 'arrow_forward'
    | 'terminal'
    | 'hub'
    | 'mail'
    | 'location_on'
    | 'database'
    | 'architecture'
    | 'public'
    | 'medical_services'
    | 'account_balance'
    | 'layers'
    | 'waves'
    | 'verified'
    | 'speed'
    | 'send'
    | 'share'
    | 'code';
  class?: string;
  size?: number;
  strokeWidth?: number;
}

const { name, class: className = '', size = 24, strokeWidth = 2 } = Astro.props;

const lucideMap = {
  developer_board: CircuitBoard,
  science: FlaskConical,
  cloud_sync: CloudCog,
  cloud_done: CloudCheck,
  cloud: Cloud,
  query_stats: LineChart,
  arrow_forward: ArrowRight,
  terminal: Terminal,
  hub: Network,
  mail: Mail,
  location_on: MapPin,
  database: Database,
  architecture: Compass,
  public: Globe,
  medical_services: Stethoscope,
  account_balance: Landmark,
  layers: Layers,
  waves: Waves,
  verified: BadgeCheck,
  speed: Gauge,
  send: Send,
  share: Share2,
  code: Code,
} as const;

const Component = lucideMap[name];
---

<Component size={size} class={className} strokeWidth={strokeWidth} aria-hidden="true" />
