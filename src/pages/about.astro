---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const portrait = '/images/portrait-steve.webp';
---

<Layout title="About — Euclidity SL" active="about">
  <!-- Confirmation banner — shown only when redirected back from Formspree with ?sent=1 -->
  <div
    id="contact-confirmation"
    role="status"
    aria-live="polite"
    class="hidden border-b border-on-background bg-primary-container px-8 py-4"
  >
    <div class="max-w-[1440px] mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <Icon name="verified" class="text-on-primary-container" />
        <span class="font-label-caps text-label-caps text-on-primary-container uppercase">
          Message received — we'll be in touch within 1-2 business days.
        </span>
      </div>
      <button
        id="contact-confirmation-close"
        type="button"
        aria-label="Dismiss"
        class="font-mono-data text-mono-data text-on-primary-container hover:opacity-70 transition-none px-2"
      >
        ✕
      </button>
    </div>
  </div>

  <script is:inline>
    (() => {
      if (!new URLSearchParams(window.location.search).has('sent')) return;
      const banner = document.getElementById('contact-confirmation');
      if (!banner) return;
      banner.classList.remove('hidden');
      document
        .getElementById('contact-confirmation-close')
        ?.addEventListener('click', () => banner.classList.add('hidden'));
    })();
  </script>

  <!-- Hero / Leader Profile -->
  <section class="border-b border-on-background grid grid-cols-1 md:grid-cols-12 min-h-[716px]">
    <div class="md:col-span-7 p-8 md:p-16 md:border-r border-on-background flex flex-col justify-center">
      <span class="font-label-caps text-label-caps text-primary mb-4 block">LEAD CONSULTANT</span>
      <h1 class="font-headline-lg text-headline-lg text-on-background uppercase mb-8 leading-[0.9]">
        STEVE PURVES.<br />
        <span class="text-secondary">FOCUSSED ON DELIVERY.</span>
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface max-w-xl mb-12">
        Euclidity SL is a boutique technical consultancy specializing in the intersection of high-performance computing, scientific visualization, and system architecture. We translate complex domain requirements into robust, production-ready systems.
      </p>
      <div class="flex flex-wrap gap-4">
        <div class="border border-on-background p-4 flex flex-col">
          <span class="font-label-caps text-label-caps text-secondary mb-1">FOUNDED</span>
          <span class="font-headline-sm text-headline-sm text-on-background">2013</span>
        </div>
        <div class="border border-on-background p-4 flex flex-col">
          <span class="font-label-caps text-label-caps text-secondary mb-1">HQ</span>
          <span class="font-headline-sm text-headline-sm text-on-background">TENERIFE / ES</span>
        </div>
        <div class="border border-on-background p-4 flex flex-col">
          <span class="font-label-caps text-label-caps text-secondary mb-1">CORE STACK</span>
          <span class="font-headline-sm text-headline-sm text-on-background">NODE / C++ / PYTHON</span>
        </div>
      </div>
    </div>
    <div class="md:col-span-5 relative bg-surface-container-low flex items-end justify-center overflow-hidden border-t md:border-t-0 border-on-background">
      <img
        class="w-full h-full object-cover grayscale contrast-125 mix-blend-multiply"
        src={portrait}
        alt="Studio portrait of Steve Purves"
      />
      <div class="absolute bottom-8 right-8 bg-background border border-on-background p-6 hard-shadow max-w-[260px]">
        <p class="font-mono-data text-mono-data leading-relaxed">
          "WE LOVE WORKING ON COMPLEX PROBLEMS, AND APPLICATIONS THAT DELIVER SCIENTIFIC AND COMPUTATIONAL CAPABILITIES."
        </p>
      </div>
    </div>
  </section>

  <!-- Mission grid -->
  <section class="p-8 md:p-16 border-b border-on-background">
    <div class="mb-16">
      <span class="font-label-caps text-label-caps text-primary mb-2 block">OUR MISSION</span>
      <h2 class="font-headline-md text-headline-md text-on-background uppercase">CORE DOMAINS OF OPERATION</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border-t border-l border-on-background">
      <div class="border-r border-b border-on-background p-10 hover:bg-primary-container group transition-none">
        <div class="mb-8">
          <Icon name="terminal" size={36} />
        </div>
        <h3 class="font-headline-sm text-headline-sm text-on-background uppercase mb-4">HARD PROBLEMS</h3>
        <p class="font-body-md text-body-md text-on-surface-variant group-hover:text-on-primary-container">
          Specializing in translating compex scientific and engineering problem sets into working, usable software where off-the-shelf solutions fail. We tackle project management, development deployment and delivery or scalable, software solutions.
        </p>
        <div class="mt-8 pt-8 border-t border-on-background/10 group-hover:border-on-primary-container/30">
          <span class="font-label-caps text-label-caps text-secondary group-hover:text-on-primary-container">REF: ALG-001</span>
        </div>
      </div>
      <div class="border-r border-b border-on-background p-10 hover:bg-primary-container group transition-none">
        <div class="mb-8">
          <Icon name="science" size={36} />
        </div>
        <h3 class="font-headline-sm text-headline-sm text-on-background uppercase mb-4">SCIENTIFIC DOMAINS</h3>
        <p class="font-body-md text-body-md text-on-surface-variant group-hover:text-on-primary-container">
          Bridging the gap between research and commercial software. Experts in buiding software in difference domains built in earth sciences, geology, geophysics, finance, biotech, medical instrumentation, large scale data visualisation and more.
        </p>
        <div class="mt-8 pt-8 border-t border-on-background/10 group-hover:border-on-primary-container/30">
          <span class="font-label-caps text-label-caps text-secondary group-hover:text-on-primary-container">REF: SCI-402</span>
        </div>
      </div>
      <div class="border-r border-b border-on-background p-10 hover:bg-primary-container group transition-none">
        <div class="mb-8">
          <Icon name="hub" size={36} />
        </div>
        <h3 class="font-headline-sm text-headline-sm text-on-background uppercase mb-4">SYSTEM BRIDGING</h3>
        <p class="font-body-md text-body-md text-on-surface-variant group-hover:text-on-primary-container">
          Designing the connective tissue between legacy infrastructure and modern cloud-native architectures. High-reliability API design and data pipeline engineering.
        </p>
        <div class="mt-8 pt-8 border-t border-on-background/10 group-hover:border-on-primary-container/30">
          <span class="font-label-caps text-label-caps text-secondary group-hover:text-on-primary-container">REF: SYS-990</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Consultation form -->
  <section id="contact" class="grid grid-cols-1 md:grid-cols-2 border-b border-on-background scroll-mt-20">
    <div class="p-8 md:p-16 border-b md:border-b-0 md:border-r border-on-background bg-on-background text-background flex flex-col justify-between">
      <div>
        <span class="font-label-caps text-label-caps text-primary-fixed mb-4 block">READY TO ENGAGE?</span>
        <h2 class="font-headline-lg text-headline-lg uppercase mb-8 leading-none">
          GET IN<br />TOUCH
        </h2>
        <p class="font-body-lg text-body-lg text-secondary-fixed-dim max-w-md">
          Describe your technical bottleneck. Tell us about your timeline.
        </p>
      </div>
      <div class="mt-12">
        <div class="flex items-center gap-4 py-4 border-t border-secondary">
          <Icon name="verified" class="text-primary-fixed" />
          <span class="font-mono-data text-mono-data">INITIAL CONTACT VIA VIDEO CALL</span>
        </div>
        <div class="flex items-center gap-4 py-4 border-t border-secondary">
          <Icon name="speed" class="text-primary-fixed" />
          <span class="font-mono-data text-mono-data">RESPONSE TIME 1-2 BUSINESS DAYS</span>
        </div>
      </div>
    </div>

    <div class="p-8 md:p-16 bg-background">
      <form
        class="space-y-12"
        action="https://formspree.io/f/xgorbpwl"
        method="POST"
      >
        <div class="space-y-2">
          <label for="name" class="font-label-caps text-label-caps text-secondary block">01. FULL NAME / ENTITY</label>
          <input
            id="name"
            name="name"
            required
            class="w-full border-b border-on-background bg-transparent p-0 py-2 focus:ring-0 focus:border-primary focus:border-b-2 outline-none font-body-md text-body-md placeholder:text-surface-container-highest"
            placeholder="REQUIRED"
            type="text"
          />
        </div>
        <div class="space-y-2">
          <label for="email" class="font-label-caps text-label-caps text-secondary block">02. COMMUNICATION ENDPOINT (EMAIL)</label>
          <input
            id="email"
            name="email"
            required
            class="w-full border-b border-on-background bg-transparent p-0 py-2 focus:ring-0 focus:border-primary focus:border-b-2 outline-none font-body-md text-body-md placeholder:text-surface-container-highest"
            placeholder="REQUIRED"
            type="email"
          />
        </div>
        <div class="space-y-2">
          <label for="message" class="font-label-caps text-label-caps text-secondary block">03. TECHNICAL SCOPE / PROBLEM DESCRIPTION</label>
          <textarea
            id="message"
            name="message"
            required
            class="w-full border-b border-on-background bg-transparent p-0 py-2 focus:ring-0 focus:border-primary focus:border-b-2 outline-none font-body-md text-body-md placeholder:text-surface-container-highest resize-none"
            placeholder="DESCRIBE THE SYSTEM PARAMETERS"
            rows="4"
          ></textarea>
        </div>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" />
        <input type="hidden" name="_subject" value="New consultation request — euclidity.com" />
        <input type="hidden" name="_next" value="https://euclidity.com/about?sent=1" />        
        <button
          type="submit"
          class="w-full bg-on-background text-background py-6 font-headline-sm text-headline-sm uppercase tracking-widest border border-on-background hover:bg-primary-container hover:text-on-primary-container transition-none flex items-center justify-center gap-4"
        >
          SEND MEETING REQUEST
          <Icon name="send" />
        </button>
      </form>
    </div>
  </section>
</Layout>
