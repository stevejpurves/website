---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const heroImage = 'https://lh3.googleusercontent.com/aida-public/AB6AXuC7zzzcpCF-DUUjRK0NUgtDTxwiXdLYaR37hOsdFTlDczyUEdzY7bS7e3suxAQgmY4yekeuIlhUG5UgaRSjTiVkD6yczSowoO6jX8P6-WxARGZ7hJTpUaneyOaDMF8HG01mfHc9tfuIxK8e0kBkOVe17BMu_tIOxx6sdHRzu5hSjz1JeHeGdYUZ4Mn9U9oxtfGRsHiRywf68-VFMMZFmNs7yXShU-C8jcDF-08MQN_hcF3e_yCI-Mw7i65r9LHYDmDMTNfAsmbo2se0';
const mapImage = 'https://lh3.googleusercontent.com/aida-public/AB6AXuB3U4cX1vKxrdxUxgdRB6tjzDMkBFolhO3kuyz0YMTB7QB1hCW0UKSe1_J2g5eMXFzljkdRlG_4OEVy-qi9bAo6H1lCEuDOt_q8ns1slEFRAfpFGWZ-pkjo2hhF1rTVaSXMdFaKkB1AV4zDQ_EFohIJOwEihRi_HnNFGY-S7OC9ES-qzjwqGuacvem7saB1ORPngmbtPfYj1NpGcZwQOEZTqAzV6cJvYfCl8vtDxvs7-mqxH2iRaaTOJvk4Bnau-nTWC-ebiOe8Sgbl';
---

<Layout title="Euclidity SL — Precision Engineering Consultancy">
  <!-- Hero -->
  <section class="max-w-[1440px] mx-auto px-16 py-xl grid grid-cols-12 gap-gutter items-center min-h-[819px]">
    <div class="col-span-12 lg:col-span-7">
      <div class="bg-primary-container text-on-primary-container inline-block px-4 py-1 mb-8 font-label-caps text-label-caps">
        EUCLIDITY SL // PRECISION SYSTEMS
      </div>
      <h1 class="font-h1 text-h1 text-on-background mb-8 max-w-4xl uppercase">
        WE ENGINEER <span class="text-primary">ABSOLUTE</span> RELIABILITY.
      </h1>
      <p class="font-body-lg text-body-lg text-secondary mb-12 max-w-2xl">
        High-performance technical consultancy specializing in mission-critical infrastructure, R&amp;D leadership, and cloud-native architectures for the modern industrial stack.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/about#contact" class="bg-primary text-on-primary px-12 py-5 font-label-caps text-label-caps border border-on-background hover:bg-on-background transition-colors">
          START PROJECT_
        </a>
        <a href="/services" class="bg-surface-container-lowest text-on-background px-12 py-5 font-label-caps text-label-caps border border-on-background hover:bg-surface-container transition-colors">
          VIEW CAPABILITIES
        </a>
      </div>
    </div>
    <div class="col-span-12 lg:col-span-5 relative">
      <div class="brutalist-border p-4 bg-surface-container-lowest" style="box-shadow: 12px 12px 0 0 var(--color-primary);">
        <img
          alt="Technical close-up of a high-precision industrial motherboard with glowing fiber optic paths and clinical silver components"
          class="w-full aspect-square object-cover grayscale contrast-125"
          src={heroImage}
          loading="eager"
        />
        <div class="mt-4 flex justify-between items-center font-mono-data text-mono-data text-secondary uppercase tracking-tighter">
          <span>System ID: 0x7AE-12</span>
          <span>Load: Stable [99.99%]</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Services bento -->
  <section class="bg-surface-container-low py-xl">
    <div class="max-w-[1440px] mx-auto px-16">
      <div class="flex flex-col md:flex-row justify-between items-end mb-16 border-b border-on-background pb-8 gap-8">
        <div>
          <span class="font-label-caps text-label-caps text-primary">[ 02 / SERVICES ]</span>
          <h2 class="font-h2 text-h2 mt-4 uppercase">Core Expertise</h2>
        </div>
        <p class="max-w-md md:text-right font-body-md text-body-md text-secondary">
          Clinical execution of complex engineering requirements. No fluff. Just architecture that scales.
        </p>
      </div>
      <div class="grid grid-cols-12 gap-4">
        <a href="/services" class="col-span-12 md:col-span-8 brutalist-border p-8 bg-surface-container-lowest brutalist-card-hover cursor-pointer block">
          <Icon name="developer_board" size={36} class="mb-6" />
          <h3 class="font-h3 text-h3 mb-4 uppercase">Full-Stack Engineering</h3>
          <p class="font-body-md text-body-md mb-8 opacity-80">
            Development of ultra-responsive, low-latency applications using Rust, Go, and distributed system paradigms. We build for performance benchmarks, not just "good enough."
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-2 py-1 bg-surface-container text-on-surface font-label-caps text-[10px]">RUST</span>
            <span class="px-2 py-1 bg-surface-container text-on-surface font-label-caps text-[10px]">KUBERNETES</span>
            <span class="px-2 py-1 bg-surface-container text-on-surface font-label-caps text-[10px]">DISTRIBUTED_DB</span>
          </div>
        </a>
        <a href="/services" class="col-span-12 md:col-span-4 brutalist-border p-8 bg-surface-container-lowest brutalist-card-hover cursor-pointer block">
          <Icon name="science" size={36} class="mb-6" />
          <h3 class="font-h3 text-h3 mb-4 uppercase">R&amp;D Leadership</h3>
          <p class="font-body-md text-body-md opacity-80">
            Strategic oversight for technical departments. We bridge the gap between abstract research and commercial engineering deployment.
          </p>
        </a>
        <a href="/services" class="col-span-12 md:col-span-4 brutalist-border p-8 bg-surface-container-lowest brutalist-card-hover cursor-pointer block">
          <Icon name="cloud_sync" size={36} class="mb-6" />
          <h3 class="font-h3 text-h3 mb-4 uppercase">Cloud Native</h3>
          <p class="font-body-md text-body-md opacity-80">
            Architecting immutable infrastructure. Automation of everything. Zero-trust security by default.
          </p>
        </a>
        <a href="/services" class="col-span-12 md:col-span-8 brutalist-border p-8 bg-surface-container-lowest brutalist-card-hover cursor-pointer flex flex-col justify-between block">
          <div>
            <Icon name="query_stats" size={36} class="mb-6" />
            <h3 class="font-h3 text-h3 mb-4 uppercase">Performance Auditing</h3>
            <p class="font-body-md text-body-md opacity-80">
              Deep-dive bottleneck analysis for legacy systems. We reduce compute overhead by up to 40% through algorithmic optimization.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-current flex justify-between items-center">
            <span class="font-label-caps text-label-caps">AUDIT_REQUESTS: OPEN</span>
            <Icon name="arrow_forward" size={24} />
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Footprint -->
  <section class="py-xl">
    <div class="max-w-[1440px] mx-auto px-16">
      <div class="grid grid-cols-12 gap-gutter">
        <div class="col-span-12 lg:col-span-4">
          <span class="font-label-caps text-label-caps text-primary">[ 03 / FOOTPRINT ]</span>
          <h2 class="font-h2 text-h2 mt-4 mb-8 uppercase">Global<br />Operation</h2>
          <div class="space-y-6">
            <div class="border-l-4 border-primary pl-4">
              <h4 class="font-bold uppercase font-label-caps text-label-caps">Madrid HQ</h4>
              <p class="text-secondary font-mono-data text-mono-data">Madrid, Technological Zone</p>
            </div>
            <div class="border-l-4 border-surface-container-highest pl-4">
              <h4 class="font-bold uppercase font-label-caps text-label-caps">Remote Clusters</h4>
              <p class="text-secondary font-mono-data text-mono-data">London, Berlin, Singapore, NYC</p>
            </div>
          </div>
        </div>
        <div class="col-span-12 lg:col-span-8 bg-surface-container-lowest brutalist-border overflow-hidden h-[500px] relative">
          <img
            alt="Minimalist abstract wireframe map of the world with bright accent data points indicating global office locations"
            class="w-full h-full object-cover opacity-90"
            src={mapImage}
          />
          <div class="absolute bottom-8 right-8 bg-on-background text-surface-container-lowest p-6 font-mono-data text-mono-data">
            <div class="grid grid-cols-2 gap-x-8 gap-y-2">
              <span>ACTIVE_NODES:</span> <span class="text-primary-container font-bold">142</span>
              <span>LATENCY_AVG:</span> <span class="text-primary-container font-bold">12ms</span>
              <span>UPTIME_ANNUAL:</span> <span class="text-primary-container font-bold">99.998%</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-on-background py-xl overflow-hidden relative">
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="h-full w-full" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 40px 40px;"></div>
    </div>
    <div class="max-w-[1440px] mx-auto px-16 text-center relative z-10">
      <h2 class="font-h1 text-h1 text-surface-container-lowest uppercase mb-12">System Upgrade Initiated.</h2>
      <p class="font-body-lg text-body-lg text-surface-container-highest mb-12 max-w-xl mx-auto">
        Contact our lead engineers to schedule a clinical technical assessment of your current infrastructure and product goals.
      </p>
      <div class="flex justify-center gap-4">
        <a href="/about#contact" class="bg-primary-container text-on-primary-container px-16 py-6 font-label-caps text-label-caps tracking-widest border border-surface-container-lowest hover:bg-surface-container-lowest hover:text-on-background transition-all">
          ESTABLISH_CONNECTION
        </a>
      </div>
    </div>
  </section>
</Layout>
