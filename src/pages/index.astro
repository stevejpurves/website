---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const heroBlueprint = '/images/home-blueprint-grid.png';
const circuitMacro = '/images/home-circuit-macro.png';
const mathNodes = '/images/home-math-nodes.png';
const tenerifeSky = '/images/home-tenerife-sky.webp';
---

<Layout title="Euclidity SL — Technology Consultancy">
  <!-- Hero -->
  <section class="min-h-[819px] flex flex-col items-center justify-center border-b border-on-background custom-grid-pattern px-8 relative overflow-hidden">
    <div class="max-w-[1440px] w-full py-24 relative z-10">
      <div class="inline-block border border-on-background px-3 py-1 mb-6 bg-primary-container">
        <span class="font-label-caps text-label-caps text-on-primary-container">EUCLIDITY SL // TECHNOLOGY CONSULTANCY</span>
      </div>
      <h1 class="font-headline-lg text-[clamp(3rem,10vw,7rem)] leading-[0.9] tracking-tighter uppercase mb-12">
        SOFTWARE<br />
        WITH A SLICE<br />
        OF <span class="text-primary-fixed-dim">SCIENCE</span><br />
      </h1>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end">
        <div class="md:col-span-6">
          <p class="font-body-lg text-body-lg max-w-xl leading-relaxed">
            Euclidity SL develops reliable engineered digital infrastructure and software systems for technical environments, applied science and engineering applications.
          </p>
        </div>
        <div class="md:col-span-6 flex justify-end gap-4">
          <div class="border border-on-background p-6 bg-background hard-shadow w-48">
            <span class="font-label-caps text-label-caps block mb-2 opacity-60">LOCATION</span>
            <span class="font-headline-md text-headline-md">EUROPE</span>
          </div>
          <div class="border border-on-background p-6 bg-primary-container hard-shadow w-48">
            <span class="font-label-caps text-label-caps block mb-2 text-on-primary-container">DELIVERY MODE</span>
            <span class="font-headline-md text-headline-md text-on-primary-container">REMOTE</span>
          </div>
        </div>
      </div>
    </div>
    <!-- Decorative blueprint image -->
    <div class="absolute right-0 bottom-0 w-1/3 h-2/3 border-l border-t border-on-background hidden lg:block overflow-hidden">
      <img
        class="w-full h-full object-cover grayscale opacity-80 hover:grayscale-0 hover:opacity-100 transition-all duration-700"
        alt="Technical blueprint grid with abstract geometric architecture"
        src={heroBlueprint}
      />
    </div>
  </section>

  <!-- Stats Grid -->
  <section class="border-b border-on-background">
    <div class="grid grid-cols-1 md:grid-cols-3">
      <div class="p-12 border-b md:border-b-0 md:border-r border-on-background hover:bg-primary-container transition-none group">
        <span class="font-label-caps text-label-caps block mb-4 group-hover:text-on-primary-container">GEOGRAPHIC REACH</span>
        <h2 class="font-headline-lg text-6xl leading-[1.1] tracking-tighter font-bold group-hover:text-on-primary-container">7+</h2>
        <p class="font-label-caps text-label-caps mt-2 group-hover:text-on-primary-container">CLIENT LOCATIONS</p>
      </div>
      <div class="p-12 border-b md:border-b-0 md:border-r border-on-background hover:bg-primary-container transition-none group">
        <span class="font-label-caps text-label-caps block mb-4 group-hover:text-on-primary-container">DOMAIN EXPERIENCE</span>
        <h2 class="font-headline-lg text-6xl leading-[1.1] tracking-tighter font-bold group-hover:text-on-primary-container">5+</h2>
        <p class="font-label-caps text-label-caps mt-2 group-hover:text-on-primary-container">DISTINCT VERTICALS</p>
      </div>
      <div class="p-12 hover:bg-primary-container transition-none group">
        <span class="font-label-caps text-label-caps block mb-4 group-hover:text-on-primary-container">RELIABILITY</span>
        <h2 class="font-headline-lg text-6xl leading-[1.1] tracking-tighter font-bold group-hover:text-on-primary-container">100%</h2>
        <p class="font-label-caps text-label-caps mt-2 group-hover:text-on-primary-container">ATTENTION TO DETAIL</p>
      </div>
    </div>
  </section>

  <!-- Services Bento -->
  <section class="px-8 md:px-16 py-16 max-w-[1440px] mx-auto">
    <div class="mb-16">
      <span class="font-label-caps text-label-caps text-primary border-b-2 border-primary pb-1">01 / CAPABILITIES</span>
      <h3 class="font-headline-md text-headline-md mt-6 uppercase tracking-tighter">CORE SPECIALIZATIONS</h3>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-0 border border-on-background">
      <!-- Service 1: Computational Workloads -->
      <a href="/services" class="md:col-span-8 p-12 border-b md:border-b-0 md:border-r border-on-background relative group overflow-hidden block">
        <div class="relative z-10">
          <Icon name="terminal" size={36} class="mb-6" />
          <h4 class="font-headline-md text-headline-md mb-6 uppercase">Cloud Applications with Clout</h4>
          <p class="font-body-lg text-body-lg max-w-xl mb-8">Architecting high-performance web applications with computing environments optimized for speed, security, and deterministic outcomes. We specialize in building solutions for complex application spaces.</p>
          <div class="flex gap-2 flex-wrap">
            <span class="border border-on-background px-3 py-1 font-label-caps text-[10px]">NODE</span>
            <span class="border border-on-background px-3 py-1 font-label-caps text-[10px]">TYPESCRIPT</span>
            <span class="border border-on-background px-3 py-1 font-label-caps text-[10px]">C++</span>
            <span class="border border-on-background px-3 py-1 font-label-caps text-[10px]">SERVERLESS</span>
            <span class="border border-on-background px-3 py-1 font-label-caps text-[10px]">DOCKER</span>
            <span class="border border-on-background px-3 py-1 font-label-caps text-[10px]">JUPYTER</span>
          </div>
        </div>
      </a>
      <!-- Service 2: Data Intensity -->
      <a href="/services" class="md:col-span-4 p-12 bg-on-background text-background flex flex-col justify-between block">
        <div>
          <Icon name="database" size={36} class="text-primary-container mb-6" />
          <h4 class="font-headline-md text-headline-sm mb-4 uppercase">Data & Algorithms</h4>
          <p class="font-mono-data text-mono-data opacity-70">In depth expertise and ability to engineer solutions incorporating data analysis, computation, vision, speech, image processing, machine learning and AI.</p>
        </div>
        <div class="mt-12 border-t border-secondary pt-6">
          <span class="font-label-caps text-label-caps text-primary-container flex items-center gap-2">
            SYSTEM SPECS <Icon name="arrow_forward" size={16} />
          </span>
        </div>
      </a>
      <!-- Service 3: Domain Expertise -->
      <a href="/services" class="md:col-span-4 p-12 border-t border-on-background block">
        <Icon name="architecture" size={36} class="mb-6" />
        <h4 class="font-headline-md text-headline-sm mb-4 uppercase">Bridging into Domain Expertise</h4>
        <p class="font-body-md text-body-md">We have a wealth of experience in working across multiple domains and industries with scientists and engineers. We work deeply with domain experts to create software that meets needs and delivers value.</p>
      </a>
      <!-- Graphic Fill -->
      <div class="md:col-span-8 p-0 border-t border-l border-on-background overflow-hidden relative min-h-[300px]">
        <img
          class="w-full h-full object-cover grayscale contrast-125"
          src={mathNodes}
          alt="Abstract 3D technical visualization of mathematical nodes"
        />
        <div class="absolute inset-0 bg-primary-container/10 mix-blend-multiply"></div>
      </div>
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="border-t border-b border-on-background">
    <div class="grid grid-cols-1 md:grid-cols-2">
      <div class="p-12 md:p-24 border-b md:border-b-0 md:border-r border-on-background">
        <h2 class="font-headline-lg text-headline-lg mb-8 uppercase leading-tight">READY TO START?</h2>
        <p class="font-body-lg text-body-lg mb-12 max-w-md">Arrange and initial technical call and we'll tell you if we can help.</p>
        <div class="flex gap-4">
          <a href="/about#contact" class="bg-on-background text-background px-8 py-4 font-label-caps text-label-caps hard-shadow hover:bg-primary-container hover:text-on-primary-container transition-none uppercase tracking-widest border border-on-background inline-block">
            REQUEST ZOOM CALL
          </a>
        </div>
      </div>
      <div class="p-12 md:p-24 bg-surface-container-low flex items-center justify-center relative overflow-hidden">
        <div class="absolute inset-0 opacity-10 pointer-events-none">
          <div class="h-full w-full custom-grid-pattern"></div>
        </div>
        <div class="relative z-10 text-center">
          <div class="text-[8rem] font-bold leading-none opacity-5 tracking-tighter absolute -top-10 left-1/2 -translate-x-1/2 whitespace-nowrap">EUCLIDITY</div>
          <p class="font-label-caps text-label-caps text-secondary mb-4">PRIMARY HEADQUARTERS</p>
          <p class="font-headline-sm text-headline-sm uppercase">SANTA CRUZ DE TENERIFE // ES</p>
          <p class="font-mono-data text-mono-data mt-2">CANARY ISLANDS, SPAIN</p>
          <div class="mt-12 w-full h-48 border border-on-background bg-background overflow-hidden">
            <img
              class="w-full h-full object-fit grayscale"
              src={tenerifeSky}
              alt="Architectural detail of an engineering building"
            />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
