---

<Layout title="Projects — Euclidity SL" active="projects">
  <!-- Hero -->
  <section class="px-16 py-xl max-w-[1440px] mx-auto border-b border-on-background">
    <div class="grid grid-cols-12 gap-gutter items-end">
      <div class="col-span-12 lg:col-span-8">
        <span class="font-label-caps text-label-caps text-primary uppercase mb-4 block">Deployment Log</span>
        <h1 class="font-h1 text-h1 text-on-background mb-8 uppercase">GLOBAL PORTFOLIO. CLINICAL EXECUTION.</h1>
      </div>
      <div class="col-span-12 lg:col-span-4 pb-8">
        <p class="font-body-lg text-body-lg text-secondary border-l-4 border-primary pl-6">
          Deploying mission-critical engineering solutions across 4+ continents. Specializing in high-stakes data visualization, technical infrastructure, and algorithmic precision.
        </p>
      </div>
    </div>
  </section>

  <!-- Segments stats -->
  <section class="bg-surface-container-lowest border-b border-on-background">
    <div class="max-w-[1440px] mx-auto grid grid-cols-2 md:grid-cols-4 divide-x divide-on-background">
      <div class="p-12 flex flex-col gap-2">
        <span class="font-label-caps text-label-caps text-secondary">SEGMENT_01</span>
        <span class="font-h3 text-h3 text-on-background">GEOSCIENCE</span>
      </div>
      <div class="p-12 flex flex-col gap-2">
        <span class="font-label-caps text-label-caps text-secondary">SEGMENT_02</span>
        <span class="font-h3 text-h3 text-on-background">MED-TECH</span>
      </div>
      <div class="p-12 flex flex-col gap-2">
        <span class="font-label-caps text-label-caps text-secondary">SEGMENT_03</span>
        <span class="font-h3 text-h3 text-on-background">FINANCE</span>
      </div>
      <div class="p-12 flex flex-col gap-2">
        <span class="font-label-caps text-label-caps text-secondary">SEGMENT_04</span>
        <span class="font-h3 text-h3 text-on-background">OPEN SCIENCE</span>
      </div>
    </div>
  </section>

  <!-- Project bento grid -->
  <section class="px-16 py-xl max-w-[1440px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
      {projects.map((p) => (
        <article class="group bg-surface-container-lowest brutalist-border flex flex-col transition-all hover:bg-surface-container">
          <div class="aspect-video overflow-hidden border-b border-on-background relative">
            <img
              class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
              src={p.image}
              alt={p.imageAlt}
              loading="lazy"
            />
            <div class="absolute top-4 right-4 bg-primary-container text-on-primary-container px-3 py-1 font-label-caps text-label-caps uppercase">
              {p.region}
            </div>
          </div>
          <div class="p-8 flex-grow">
            <span class="font-label-caps text-label-caps text-primary mb-2 block">{p.segment}</span>
            <h3 class="font-h3 text-h3 mb-4 uppercase">{p.name}</h3>
            <p class="font-body-md text-body-md text-secondary">{p.blurb}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-on-background text-surface-container-lowest px-16 py-xl">
    <div class="max-w-[1440px] mx-auto text-center">
      <h2 class="font-h1 text-h1 mb-12 tracking-tighter uppercase">READY_FOR_DEPLOYMENT?</h2>
      <div class="flex flex-col md:flex-row justify-center gap-8">
        <a href="/about#contact" class="bg-primary-container text-on-primary-container px-12 py-6 font-h3 text-h3 hover:bg-surface-container-lowest hover:text-on-background transition-all brutalist-border uppercase">INITIATE_PROJECT</a>
        <a href="/services" class="bg-transparent text-surface-container-lowest border border-surface-container-lowest px-12 py-6 font-h3 text-h3 hover:bg-surface-container-lowest hover:text-on-background transition-all uppercase">VIEW_CAPABILITIES</a>
      </div>
    </div>
  </section>
</Layout>
