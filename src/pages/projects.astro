---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Projects — Euclidity SL" active="projects">
  <main class="max-w-[1440px] mx-auto px-8 py-16">
    <!-- Hero -->
    <section class="mb-24">
      <div class="grid grid-cols-12 gap-gutter border-b border-on-background pb-12">
        <div class="col-span-12 md:col-span-8">
          <span class="font-label-caps text-label-caps text-primary border border-on-background px-2 py-1 mb-6 inline-block">PORTFOLIO_INDEX_V2.0</span>
          <h1 class="font-headline-lg text-headline-lg uppercase mb-6 leading-none">
            Global Technology<br />Consultancy.
          </h1>
          <p class="font-body-lg text-body-lg max-w-2xl text-on-surface-variant">
            Mapping complex technical challenges to elegant architectural solutions. High-stakes software engineering across continents and critical industries.
          </p>
        </div>
        <div class="col-span-12 md:col-span-4 flex flex-col justify-end items-end text-right">
          <div class="font-mono-data text-mono-data border-l border-on-background pl-4">
            <div class="text-on-background font-bold">SELECTED_PROJECTS: 09</div>
            <div class="text-secondary">CLIENT_LOCATIONS: 07</div>
            <div class="text-secondary">DELVIERED: REMOTELY</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Bento -->
    <section class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <!-- Curvenote -->
      <article class="md:col-span-8 border border-on-background p-0 group overflow-hidden flex flex-col">
        <div class="aspect-video w-full border-b border-on-background relative bg-surface-container overflow-hidden">
          <img
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
            src="/images/project-curvenote.png"
            alt="Abstract mathematical nodes and scientific data visualization"
            loading="lazy"
          />
        </div>
        <div class="p-6 flex flex-col flex-grow">
          <div class="flex justify-between items-start mb-4">
            <div>
              <h3 class="font-headline-sm text-headline-sm uppercase">Curvenote</h3>
              <p class="font-label-caps text-label-caps text-primary">CANADA / SCIENTIFIC PUBLISHING</p>
            </div>
            <Icon name="science" size={32} class="group-hover:text-primary transition-colors" />
          </div>
          <p class="font-body-md text-body-md text-secondary mb-6">Open-science infrastructure and collaborative computational research tools for the global scientific community. We provide fractional CTO and software development services.</p>
          <div class="mt-auto pt-4 border-t border-surface-container-highest flex gap-2">
            <span class="px-2 py-1 border border-on-background font-mono-data text-[10px]">REACT</span>
            <span class="px-2 py-1 border border-on-background font-mono-data text-[10px]">TYPESCRIPT</span>
            <span class="px-2 py-1 border border-on-background font-mono-data text-[10px]">LATEX</span>
          </div>
        </div>
      </article>

      <!-- Earth Science Analytics -->
      <article class="md:col-span-4 border border-on-background p-6 group hover:bg-on-background hover:text-background transition-none">
        <div class="flex justify-between items-start mb-12">
          <div>
            <h3 class="font-headline-sm text-headline-sm uppercase">Earth Science Analytics</h3>
            <p class="font-label-caps text-label-caps text-primary">NORWAY / GEOSCIENCE</p>
          </div>
          <Icon name="public" size={32} />
        </div>
        <p class="font-body-md text-body-md mb-8">AI-driven geoscience software providing cloud-native solutions for subsurface data interpretation and risk mitigation. We provided R&D leadership, softeare development and data science service delivery for their clients in the Oil & Gas industry.</p>
        <div class="font-mono-data text-mono-data space-y-1">
          <div class="flex justify-between border-b border-surface-container-highest group-hover:border-secondary py-1">
            <span>LOCATION:</span> <span>STAVANGER</span>
          </div>
          <div class="flex justify-between border-b border-surface-container-highest group-hover:border-secondary py-1">
            <span>STATUS:</span> <span>CLEINT WAS AQUIRED</span>
          </div>
        </div>
      </article>

      <!-- Renesas -->
      <article class="md:col-span-4 border border-on-background p-6 flex flex-col justify-between group">
        <div>
          <div class="w-full aspect-square border border-on-background mb-6 bg-surface-container-low relative overflow-hidden">
            <img
              class="w-full h-full object-cover grayscale opacity-50 group-hover:opacity-100 group-hover:grayscale-0 transition-all"
              src="/images/project-renesas.png"
              alt="Macro photograph of a precision semiconductor wafer"
              loading="lazy"
            />
          </div>
          <h3 class="font-headline-sm text-headline-sm uppercase">Renesas</h3>
          <p class="font-label-caps text-label-caps text-primary mb-4">USA / SEMICONDUCTORS</p>
          <p class="font-body-md text-body-md text-secondary">[VIA EXPERO] Advanced microcontroller and analog solutions for automotive and industrial intelligence. We worked on producization of the Power Compass power supply design tool, taking this from excel and visual basic prototypes, to a reliable offline capable web application.</p>
        </div>
        <a href="https://www.renesas.com/en/software-tool/powercompass-multi-rail-design-tool" class="mt-8 w-full py-3 border border-on-background font-label-caps text-label-caps hover:bg-primary-container hover:text-on-primary-container transition-none text-center inline-block" target="_blank">
          VIEW_APP
        </a>
      </article>

      <!-- Expero -->
      <article class="md:col-span-8 border border-on-background p-0 group overflow-hidden grid md:grid-cols-2">
        <div class="p-8 border-b md:border-b-0 md:border-r border-on-background flex flex-col">
          <div class="mb-auto">
            <h3 class="font-headline-sm text-headline-sm uppercase">Expero</h3>
            <p class="font-label-caps text-label-caps text-primary mb-4">USA / COMPLEX DOMAINS</p>
            <p class="font-body-md text-body-md text-secondary">Engineering custom software for high-value operations including logistics, supply chain, and fraud detection. We sub contracted with Expeor inc on multple projects, providing project leadership, software architecture and development services in UX-led projects across multiple industies; Electronics, finance, payment systems and genomics startups.</p>
          </div>
          <div class="grid grid-cols-2 gap-4 mt-8">
            <div class="border border-on-background p-3 text-center">
              <span class="block font-headline-sm text-headline-sm">MULITPLE</span>
              <span class="font-label-caps text-[10px]">PROJECTS</span>
            </div>
            <div class="border border-on-background p-3 text-center">
              <span class="block font-headline-sm text-headline-sm">3+</span>
              <span class="font-label-caps text-[10px]">YEARS</span>
            </div>
          </div>
        </div>
        <div class="bg-on-background flex items-center justify-center p-8">
          <img
            class="w-full h-auto opacity-80"
            src="/images/project-expero.png"
            alt="Complex network graph visualization"
            loading="lazy"
          />
        </div>
      </article>

      <!-- Small cards row -->
      <div class="md:col-span-12 grid grid-cols-1 md:grid-cols-5 gap-8">
        <article class="border border-on-background p-6 group hover:border-primary-container transition-none">
          <Icon name="medical_services" class="mb-4" />
          <h4 class="font-headline-sm text-lg uppercase">Dentisphere</h4>
          <p class="font-label-caps text-[10px] text-secondary mb-4">BELGIUM / HEALTHCARE</p>
          <p class="font-body-md text-sm text-secondary">Node.js integrations into legacy x-ray ultrasound and camera hardware systems.</p>
        </article>
        <article class="border border-on-background p-6 group hover:border-primary-container transition-none">
          <Icon name="account_balance" class="mb-4" />
          <h4 class="font-headline-sm text-lg uppercase">Finance/Payments</h4>
          <p class="font-label-caps text-[10px] text-secondary mb-4">USA / FINTECH</p>
          <p class="font-body-md text-sm text-secondary">Worked on high-throughput payment micro services.</p>
        </article>
        <article class="border border-on-background p-6 group hover:border-primary-container transition-none">
          <Icon name="terminal" class="mb-4" />
          <h4 class="font-headline-sm text-lg uppercase">AirPair</h4>
          <p class="font-label-caps text-[10px] text-secondary mb-4">USA / DEV_TOOLS</p>
          <p class="font-body-md text-sm text-secondary">Built cloud based automation apps for video call based micro-consulting.</p>
        </article>
        <article class="border border-on-background p-6 group hover:border-primary-container transition-none">
          <Icon name="layers" class="mb-4" />
          <h4 class="font-headline-sm text-lg uppercase">Geoteric</h4>
          <p class="font-label-caps text-[10px] text-secondary mb-4">UK / ENERGY</p>
          <p class="font-body-md text-sm text-secondary">Intellectual property auditing and algorithm development for 3D seismic interpretation software.</p>
        </article>
        <article class="border border-on-background p-6 group hover:border-primary-container transition-none">
          <Icon name="waves" class="mb-4" />
          <h4 class="font-headline-sm text-lg uppercase">Sharp Refl.</h4>
          <p class="font-label-caps text-[10px] text-secondary mb-4">GERMANY / ANALYTICS</p>
          <p class="font-body-md text-sm text-secondary">Audit of distributed rendering systems architecture and development roadmap.</p>
        </article>
      </div>
    </section>

    <!-- CTA -->
    <section class="mt-32 mb-16">
      <div class="border-2 border-on-background p-12 text-center relative overflow-hidden">
        <div class="absolute inset-0 translate-x-1 translate-y-1 bg-primary-container -z-10"></div>
        <div class="absolute inset-0 bg-background -z-0"></div>
        <div class="relative z-10">
          <h2 class="font-headline-lg text-headline-lg uppercase mb-8">READY_TO_START?</h2>
          <p class="font-body-lg text-body-lg mb-10 max-w-xl mx-auto">
            We are currently accepting new technical challenges. Book a call to startegy.
          </p>
          <div class="flex flex-col md:flex-row justify-center gap-4">
            <a href="/about#contact" class="bg-on-background text-background px-10 py-4 font-label-caps text-label-caps border border-on-background hover:bg-primary-container hover:text-on-primary-container transition-none flex items-center justify-center gap-2 inline-flex">
              GET_IN_TOUCH <Icon name="arrow_forward" size={16} />
            </a>
            <a href="/services" class="bg-background text-on-background px-10 py-4 font-label-caps text-label-caps border border-on-background hover:bg-surface-container transition-none inline-block">
              VIEW_SERVICES
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
