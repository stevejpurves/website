---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const serverImage = '/images/services-server-hardware.png';
---

<Layout title="Services — Euclidity SL" active="services">
  <div class="max-w-[1440px] mx-auto min-h-screen">
    <!-- Hero -->
    <section class="px-8 pt-24 pb-16 border-b border-on-background grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <div class="md:col-span-8">
        <span class="font-label-caps text-label-caps text-primary mb-4 block">01 / CAPABILITIES</span>
        <h1 class="font-headline-lg text-headline-lg uppercase leading-none mb-8">
          Engineering<br />Experience for<br />Complex Systems.
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">
          We architect and build high-performance software for environments where failure is not an option. From low-level systems to fractional leadership, we provide the technical muscle to scale high-stakes infrastructure.
        </p>
      </div>
      <div class="md:col-span-4 flex items-end justify-end">
        <div class="w-full aspect-square border border-on-background p-4 flex flex-col justify-between">
          <span class="font-mono-data text-mono-data uppercase">[ SERVICES: AVAILABLE ]</span>
          <div class="font-headline-md text-headline-md leading-none">TECHNICAL<br />MASTERY.</div>
        </div>
      </div>
    </section>

    <!-- Services Bento -->
    <section class="grid grid-cols-1 md:grid-cols-12 border-b border-on-background">
      <!-- Full-Stack Engineering -->
      <div class="md:col-span-6 border-b md:border-b-0 md:border-r border-on-background p-8 group hover:bg-primary-container transition-none">
        <div class="flex justify-between items-start mb-12">
          <Icon name="terminal" size={36} />
          <span class="font-mono-data text-mono-data opacity-50">02.1</span>
        </div>
        <h3 class="font-headline-sm text-headline-sm uppercase mb-4">Full-Stack Engineering</h3>
        <p class="font-body-md text-body-md mb-8 text-on-surface-variant group-hover:text-on-primary-container">Production-ready implementation across the entire stack. We favor strongly-typed systems and deterministic performance.</p>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 border border-on-background text-xs font-bold uppercase">Typescript</span>
          <span class="px-3 py-1 border border-on-background text-xs font-bold uppercase">Node</span>
          <span class="px-3 py-1 border border-on-background text-xs font-bold uppercase">Rust</span>
          <span class="px-3 py-1 border border-on-background text-xs font-bold uppercase">Python</span>
          <span class="px-3 py-1 border border-on-background text-xs font-bold uppercase">C++</span>
        </div>
      </div>
      <!-- R&D Leadership -->
      <div class="md:col-span-6 p-8 group hover:bg-primary-container transition-none">
        <div class="flex justify-between items-start mb-12">
          <Icon name="science" size={36} />
          <span class="font-mono-data text-mono-data opacity-50">02.2</span>
        </div>
        <h3 class="font-headline-sm text-headline-sm uppercase mb-4">R&amp;D Leadership</h3>
        <p class="font-body-md text-body-md mb-8 text-on-surface-variant group-hover:text-on-primary-container">Bridging the gap between academic research and commercial software. We specialize in algorithmic optimization and visual intelligence.</p>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 border border-on-background text-xs font-bold uppercase">Machine Learning</span>
          <span class="px-3 py-1 border border-on-background text-xs font-bold uppercase">Algorithm Dev</span>
          <span class="px-3 py-1 border border-on-background text-xs font-bold uppercase">Computer Vision</span>
        </div>
      </div>
      <!-- Fractional CTO -->
      <div class="md:col-span-6 border-t md:border-r border-on-background p-8 group hover:bg-primary-container transition-none">
        <div class="flex justify-between items-start mb-12">
          <Icon name="architecture" size={36} />
          <span class="font-mono-data text-mono-data opacity-50">02.3</span>
        </div>
        <h3 class="font-headline-sm text-headline-sm uppercase mb-4">Fractional CTO</h3>
        <p class="font-body-md text-body-md mb-8 text-on-surface-variant group-hover:text-on-primary-container">Strategic technical governance for growing ventures. Roadmap validation, technical hiring, and architecture audit without the full-time overhead.</p>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 border border-on-background text-xs font-bold uppercase">Governance</span>
          <span class="px-3 py-1 border border-on-background text-xs font-bold uppercase">Audit</span>
          <span class="px-3 py-1 border border-on-background text-xs font-bold uppercase">Mentorship</span>
        </div>
      </div>
      <!-- Cloud Native -->
      <div class="md:col-span-6 border-t border-on-background p-8 group hover:bg-primary-container transition-none">
        <div class="flex justify-between items-start mb-12">
          <Icon name="cloud_done" size={36} />
          <span class="font-mono-data text-mono-data opacity-50">02.4</span>
        </div>
        <h3 class="font-headline-sm text-headline-sm uppercase mb-4">Cloud Native Architectures</h3>
        <p class="font-body-md text-body-md mb-8 text-on-surface-variant group-hover:text-on-primary-container">Resilient systems designed for hyperscale. We focus on latency reduction, zero-trust security, and horizontal scalability.</p>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 border border-on-background text-xs font-bold uppercase">Performance</span>
          <span class="px-3 py-1 border border-on-background text-xs font-bold uppercase">Resilience</span>
          <span class="px-3 py-1 border border-on-background text-xs font-bold uppercase">Kubernetes</span>
        </div>
      </div>
    </section>

    <!-- Methodology -->
    <section class="border-b border-on-background grid grid-cols-1 md:grid-cols-12">
      <div class="md:col-span-4 border-b md:border-b-0 md:border-r border-on-background p-8 bg-surface-container-low">
        <span class="font-label-caps text-label-caps block mb-12">03 / METHODOLOGY</span>
        <h2 class="font-headline-md text-headline-md uppercase leading-tight mb-8">
          Solving Hard<br />Integration<br />Problems.
        </h2>
        <div class="border-t border-on-background pt-8">
          <p class="font-body-md text-body-md text-on-surface-variant">We don't do 'easy'. We specialize in the friction points between legacy systems and modern tech stacks.</p>
        </div>
      </div>
      <div class="md:col-span-8 p-0">
        <div class="grid grid-cols-1 md:grid-cols-2">
          <div class="p-8 border-b border-on-background">
            <div class="flex items-center gap-4 mb-4">
              <span class="bg-on-background text-background w-8 h-8 flex items-center justify-center font-mono-data text-xs">01</span>
              <h4 class="font-label-caps text-label-caps uppercase">Domain Mastery</h4>
            </div>
            <p class="font-body-md text-body-md text-on-surface-variant">Deep immersion into the technical landscape. We learn your constraints before writing a single line of code.</p>
          </div>
          <div class="p-8 border-b border-on-background md:border-l">
            <div class="flex items-center gap-4 mb-4">
              <span class="bg-on-background text-background w-8 h-8 flex items-center justify-center font-mono-data text-xs">02</span>
              <h4 class="font-label-caps text-label-caps uppercase">First Principles</h4>
            </div>
            <p class="font-body-md text-body-md text-on-surface-variant">Deconstructing problems into their fundamental components to avoid bloated abstraction layers.</p>
          </div>
          <div class="p-8 border-b md:border-b-0 border-on-background">
            <div class="flex items-center gap-4 mb-4">
              <span class="bg-on-background text-background w-8 h-8 flex items-center justify-center font-mono-data text-xs">03</span>
              <h4 class="font-label-caps text-label-caps uppercase">Rigorous Validation</h4>
            </div>
            <p class="font-body-md text-body-md text-on-surface-variant">Continuous automated testing and performance profiling integrated into the core development loop.</p>
          </div>
          <div class="p-8 md:border-l border-on-background">
            <div class="flex items-center gap-4 mb-4">
              <span class="bg-on-background text-background w-8 h-8 flex items-center justify-center font-mono-data text-xs">04</span>
              <h4 class="font-label-caps text-label-caps uppercase">Legacy Coexistence</h4>
            </div>
            <p class="font-body-md text-body-md text-on-surface-variant">Building bridges, not islands. We ensure new systems integrate seamlessly with existing infrastructure.</p>
          </div>
        </div>
      </div>
    </section>



    <!-- Visual Anchor -->
    <section class="w-full border-b border-on-background h-[400px] relative overflow-hidden">
      <img
        alt="Close-up of high-performance server hardware"
        class="w-full h-full object-cover grayscale brightness-50 contrast-125"
        src={serverImage}
      />
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="border-2 border-primary-container p-12 text-center bg-on-background/40 backdrop-blur-sm">
          <div class="text-primary-container leading-tight uppercase font-bold text-xl">
            DELIVERING SOFTWARE REMOTELY <br />SINCE 2013
          </div>
        </div3
      </div>
    </section>
  </div>
</Layout>
